# Rename this file to .env and set values for your own computer.
PORT=3000
NODE_ENV=development

# XAMPP MySQL/MariaDB defaults often use root with a blank password locally.
# If you configured a MySQL password, enter it below.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bizflow_pro

# Frontend origin. For local file:// HTML development, CORS origin checking is not restrictive.
# If later served by a dev server, set its origin here, e.g. http://127.0.0.1:5500
FRONTEND_ORIGIN=http://127.0.0.1:5500/
